# ========================================
# 🎯 CYANIX AI - DISCORD MODERATION BOT
# ========================================
# Version: 2.0.0 | Powered by OpenAI & HuggingFace

# ====================
# 🔑 API CREDENTIALS
# ====================

# OPENAI_API_KEY: Your OpenAI API Key for text moderation
# Get one at: https://platform.openai.com/api-keys
# Note: OpenAI's Moderation API is FREE to use!
OPENAI_API_KEY=your_openai_api_key_here

# HUGGINGFACE_TOKEN: Optional Hugging Face token for better image moderation
# Get one at: https://huggingface.co/settings/tokens
# Optional but recommended for enhanced performance
HUGGINGFACE_TOKEN=your_huggingface_token_optional

# DISCORD_BOT_TOKEN: Your Discord Bot Token from Discord Developer Portal
# Create bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ====================
# ⚙️ BOT CONFIGURATION
# ====================

# BOT_PREFIX: Command prefix for legacy commands
# Default: $ (keeps compatibility with original)
BOT_PREFIX=$

# DEFAULT_LANGUAGE: Primary language for moderation
# Options: en, es, fr, de, it, pt, ru, ja, ko, zh
DEFAULT_LANGUAGE=en

# ====================
# 🎛️ MODERATION SETTINGS
# ====================

# MODERATION_ENABLED: Enable/disable AI moderation globally
# Default: true
MODERATION_ENABLED=true

# TEXT_MODERATION: Enable/disable text moderation
# Default: true
TEXT_MODERATION=true

# IMAGE_MODERATION: Enable/disable image moderation
# Default: true
IMAGE_MODERATION=true

# DEFAULT_SENSITIVITY: AI sensitivity level (0.0 to 1.0)
# Higher = more strict, Lower = more lenient
# Recommended: 0.7-0.85 for balanced moderation
DEFAULT_SENSITIVITY=0.75

# WARNING_SYSTEM: Enable warning system with mutes
# Default: false
WARNING_SYSTEM=false

# WARNING_LIMIT: Number of warnings before mute
# Default: 3
WARNING_LIMIT=3

# DEFAULT_MUTE_TIME: Mute duration format
# Format: 1s, 5m, 2h, 1d
# Default: 10m
DEFAULT_MUTE_TIME=10m

# ====================
# 📊 LOGGING & ANALYTICS
# ====================

# ENABLE_LOGGING: Enable detailed logging to file
# Default: true
ENABLE_LOGGING=true

# LOG_LEVEL: Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# ENABLE_ANALYTICS: Collect anonymous usage statistics
# Helps improve Cyanix AI - No personal data collected
# Default: true
ENABLE_ANALYTICS=true

# ====================
# 🚨 TRIGGERING WORDS SYSTEM
# ====================

# USE_TRIGGERING_WORDS: Only moderate messages containing triggering words
# Setting to "false" moderates ALL messages (recommended for high-traffic servers)
USE_TRIGGERING_WORDS=false

# TRIGGERING_WORDS_FILE: Path to triggering words file
# Format: One word per line or comma-separated
TRIGGERING_WORDS_FILE=./wordlist.txt

# ====================
# 🏃 PERFORMANCE OPTIONS
# ====================

# CACHE_ENABLED: Enable AI response caching for performance
# Default: true
CACHE_ENABLED=true

# CACHE_DURATION: Cache duration in seconds
# Default: 300 (5 minutes)
CACHE_DURATION=300

# MAX_IMAGE_SIZE_MB: Maximum image size to process
# Default: 10
MAX_IMAGE_SIZE_MB=10

# API_TIMEOUT: API timeout in seconds
# Default: 30
API_TIMEOUT=30

# ====================
# 🎨 CUSTOMIZATION
# ====================

# BOT_NAME: Custom bot name for responses
# Default: Cyanix AI
BOT_NAME=Cyanix AI

# BOT_COLOR: Embed color in hex (without #)
# Default: 5865F2 (Discord blurple)
BOT_COLOR=5865F2

# ENABLE_WELCOME_MESSAGE: Send welcome message on server join
# Default: true
ENABLE_WELCOME_MESSAGE=true

# ====================
# ⚠️ ADVANCED SETTINGS
# ====================

# DATABASE_TYPE: Database for persistent storage
# Options: json, sqlite, postgresql
# Default: json (simple, no setup required)
DATABASE_TYPE=json

# AUTO_UPDATE: Enable automatic updates
# Default: false
AUTO_UPDATE=false

# BACKUP_ENABLED: Enable automatic backups
# Default: true
BACKUP_ENABLED=true

# DEBUG_MODE: Enable debug features
# WARNING: May log sensitive information
# Default: false
DEBUG_MODE=false

# ====================
# 🌐 NETWORK SETTINGS
# ====================

# PROXY_URL: Optional proxy URL for API requests
# Format: http://user:pass@proxy:port
# PROXY_URL=

# RATE_LIMIT_DELAY: Delay between API calls in seconds
# Prevents rate limiting
RATE_LIMIT_DELAY=0.5

# ========================================
# 🎉 CYANIX AI READY FOR DEPLOYMENT!
# ========================================

# For help, visit: https://github.com/yourusername/cyanix-ai
# Join our Discord: https://discord.gg/cyanix